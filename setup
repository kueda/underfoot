#!/bin/bash
#
#  Bare-metal setup: build bin/imposm and bin/e00compr and create the venv.
#  Most development uses the Docker image instead (see README.md); this is for
#  running the pipeline directly on a Linux host. The apt package list lives in
#  Dockerfile's `runtime` stage.
#

if [ -d bin/e00compr ]; then
    echo "E00CONV ALREADY SET UP"
else
  echo "SETTING UP E00CONV..."
  (
    mkdir -p bin
    tar xzf vendor/e00compr-1.0.1.tar.gz -C bin
    cd bin
    ln -s e00compr-1.0.1 e00compr
    make -C e00compr-1.0.1 e00conv
  )
fi

if [ -f bin/imposm ]; then
    echo "IMPOSM ALREADY SET UP"
else
  echo "SETTING UP IMPOSM..."
  (
    mkdir -p bin && cd bin
    git clone --branch v0.14.2 --depth 1 https://github.com/omniscale/imposm3.git
    cd imposm3
    make build
    cd ..
    ln -s imposm3/imposm imposm
  )
fi

echo "INSTALLING PYTHON PACKAGES..."
virtualenv venv -p python3
source venv/bin/activate
pip install -r requirements.txt

echo "FINISHED INSTALLING LOCAL DEPENDENCIES"
